{
  "name": "Institute",
  "type": "object",
  "properties": {
    "institute_name": {
      "type": "string",
      "title": "Institute Name"
    },
    "institute_code": {
      "type": "string",
      "title": "Institute Code"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "title": "Status"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "centre_head_id": {
      "type": "string",
      "title": "Centre Head User ID"
    },
    "centre_head_name": {
      "type": "string",
      "title": "Centre Head Name"
    }
  },
  "required": [
    "institute_name",
    "institute_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": {
            "$in": "{{user.data.institute_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}