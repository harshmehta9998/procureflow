{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "centre_head",
        "super_admin",
        "finance"
      ],
      "default": "admin",
      "title": "Role"
    },
    "institute_id": {
      "type": "string",
      "title": "Primary Institute ID"
    },
    "institute_name": {
      "type": "string",
      "title": "Primary Institute Name"
    },
    "institute_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Mapped Institute IDs"
    },
    "institute_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Mapped Institute Names"
    }
  }
}