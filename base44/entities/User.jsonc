{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "title": "Platform Role"
    },
    "app_role": {
      "type": "string",
      "enum": [
        "admin",
        "centre_head",
        "super_admin",
        "finance"
      ],
      "default": "admin",
      "title": "Application Role"
    },
    "institute_id": {
      "type": "string",
      "title": "Primary Institute ID"
    },
    "institute_name": {
      "type": "string",
      "title": "Primary Institute Name"
    },
    "institute_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Mapped Institute IDs"
    },
    "institute_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Mapped Institute Names"
    },
    "mobile_number": {
      "type": "string",
      "title": "Mobile Number"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "title": "Account Status"
    },
    "must_change_password": {
      "type": "boolean",
      "default": false,
      "title": "Must Change Password"
    }
  }
}